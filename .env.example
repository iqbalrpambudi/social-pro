# Server Environment
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
FRONTEND_ORIGIN=http://localhost:5173
LOG_LEVEL=debug

# Database (PostgreSQL)
# Note: port 5434 mapped via compose.yaml to avoid collisions with other local databases
DATABASE_URL=postgres://app:app@localhost:5434/social_uploader

# Storage (S3 / MinIO)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=social-uploader
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
STORAGE_FORCE_PATH_STYLE=true
PRESIGNED_URL_TTL_SECONDS=900
MAX_UPLOAD_BYTES=1073741824

# Security & Token Encryption (AES-256-GCM 32-byte key)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
TOKEN_ENCRYPTION_KEY_VERSION=1

# Simple User Auth Token (MVP)
API_SECRET_TOKEN=smu_secret_token_dev_12345

# YouTube OAuth & API (Opsional untuk Dev/Mock mode)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:4000/v1/oauth/youtube/callback
YOUTUBE_DAILY_QUOTA_LIMIT=10000

# Mode Mock Provider (true = gunakan MockAdapter yang mensimulasikan publish YouTube tanpa kuota)
ENABLE_MOCK_ADAPTER=true
